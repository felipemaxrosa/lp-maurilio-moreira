# Sanity — sanity.io/manage → seu projeto → API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Webhook de revalidação: use o MESMO segredo aqui, na Vercel e no painel do
# Sanity (Manage → API → Webhooks).
SANITY_REVALIDATE_SECRET=

# Opcional — só se o dataset for privado (leitura via token, server-only):
# SANITY_API_READ_TOKEN=

# Google Analytics 4 — ID de medição (começa com G-). Crie a propriedade em
# analytics.google.com. O GA só carrega no navegador APÓS o aceite de cookies.
# Sem este valor, nenhum script do Google é carregado.
NEXT_PUBLIC_GA_ID=
